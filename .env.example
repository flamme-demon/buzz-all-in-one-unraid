# Copiez ce fichier en .env pour l'utiliser avec docker-compose.yml.
# Avec le template Unraid, ces mêmes clés sont saisies dans l'interface.

# Tag de l'image officielle du relay dont les binaires sont repris.
# « latest » suit la dernière build publiée ; épinglez un sha-xxxxxxx pour
# figer une version (voir README, section Mises à jour).
BUZZ_TAG=latest

# Port publié sur l'hôte pour l'interface web + le WebSocket.
BUZZ_PORT=3000

# Emplacement des données persistantes.
# Sur Unraid : /mnt/user/appdata/buzz
BUZZ_DATA=./data

# Adresse publique du relay, telle que vos clients la joignent.
# Elle sert aux défis d'authentification NIP-42 : une valeur incorrecte se
# traduit par des clients qui se connectent puis échouent à s'authentifier.
RELAY_URL=ws://localhost:3000

# Clé publique Nostr de l'opérateur, en hexadécimal minuscule (64 caractères).
# Vide = relay OUVERT, sans restriction d'appartenance.
RELAY_OWNER_PUBKEY=

# Propriétaire des fichiers dans le volume de données (99:100 = nobody:users
# sur Unraid).
PUID=99
PGID=100

TZ=Europe/Paris

# Authentification Blossom exigée pour lire les médias.
BUZZ_REQUIRE_MEDIA_GET_AUTH=true

# Origines navigateur autorisées, séparées par des virgules (reverse proxy).
# BUZZ_CORS_ORIGINS=https://buzz.mondomaine.tld

RUST_LOG=buzz_relay=info,buzz_datastore=info,tower_http=warn
