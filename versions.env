# Versions des composants embarqués dans l'image all-in-one.
#
# Ce fichier est la source de vérité : build.sh le lit, et le workflow
# .github/workflows/watch-upstream.yml le met à jour automatiquement quand une
# nouvelle version est publiée en amont. Ne modifiez pas les valeurs à la main
# dans le Dockerfile — elles y sont dupliquées uniquement comme valeurs par
# défaut pour un `docker build` lancé sans arguments.

# Relay Buzz. BUZZ_REF est épinglé sur un digest pour que la même commande de
# build produise toujours la même image ; BUZZ_TAG n'est là que pour l'affichage
# et l'étiquetage.
BUZZ_TAG=desktop-v0.5.4
BUZZ_REF=ghcr.io/block/buzz@sha256:a0f67203d71d15d237fa7517788799957c30c8acdb81cbcff711e07e951c2710

# Superviseur du conteneur.
S6_OVERLAY_VERSION=3.2.3.2

# Stockage objet des médias. Versions alignées sur celles utilisées par le
# chart Helm officiel de Buzz.
MINIO_VERSION=RELEASE.2025-09-07T16-13-09Z
MC_VERSION=RELEASE.2025-08-13T08-35-41Z

# Branche majeure de Postgres. Buzz cible Postgres 17 ; un changement de
# majeure imposerait une migration du cluster existant, il reste donc manuel.
PG_MAJOR=17
